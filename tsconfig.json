{
  "compilerOptions": {
    "baseUrl": "src",
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "typeRoots": ["./types"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@lib/*": ["lib/*"],
      "@data/*": ["data/*"],
      "@hook/*": ["hooks/*"],
      "@utils/*": ["utils/*"],
      "@context/*": ["contexts/*"],
      "@reducer/*": ["reducers/*"],
      "@component/*": ["components/*"],
      "@sections/*": ["page-sections/*"],
      "@models/*": ["models/*"]
    },
    "strictNullChecks": true
  },
  "include": ["types/next-auth.d.ts", "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
